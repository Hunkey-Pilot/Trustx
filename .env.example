# Copy to `.env` (git-ignored) and replace every <PLACEHOLDER>. Never commit real values.

# --- Backend (read from the repository-root .env) ---
DATABASE_URL=postgresql+psycopg://postgres:<PASSWORD>@localhost:5432/trustx

# API keys for the two roles. Generate long random values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TRUSTX_ANALYST_API_KEY=<ANALYST_API_KEY>
TRUSTX_ADMIN_API_KEY=<ADMIN_API_KEY>

# Optional tuning (defaults shown)
# TRUSTX_DUPLICATE_WINDOW_SECONDS=86400
# TRUSTX_RATE_LIMIT_PER_MINUTE=120
# NETWORK_UNIQUE_SENDERS_THRESHOLD=5
# NETWORK_UNIQUE_RECIPIENTS_THRESHOLD=5
# COUNTERFACTUAL_MIN_PROBABILITY_REDUCTION=0.05

# --- Frontend (put these in frontend/.env.local, which is git-ignored) ---
# URL of the FastAPI backend, used by the frontend server-side proxy:
#   NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Analyst API key, server-only (never prefix with NEXT_PUBLIC_):
#   TRUSTX_API_KEY=<ANALYST_API_KEY>
